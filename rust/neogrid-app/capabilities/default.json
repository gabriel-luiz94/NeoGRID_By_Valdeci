{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App NeoGrid: commands proprios + eventos.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-db-open",
    "allow-db-open-dialog",
    "allow-db-info",
    "allow-db-close",
    "allow-db-query",
    "allow-db-pick-folder",
    "allow-db-pick-output",
    "allow-db-build-start",
    "allow-db-build-cancel",
    "allow-db-build-busy",
    "allow-project-status",
    "allow-project-write-autosave",
    "allow-project-read-autosave",
    "allow-project-clear-autosave",
    "allow-project-save-as",
    "allow-project-open-file",
    "allow-file-save",
    "allow-file-reveal",
    "allow-app-open-external",
    "allow-app-info",
    "allow-auth-request",
    "allow-update-check",
    "allow-update-install",
    "allow-window-overlay-theme",
    "allow-net-fetch-text",
    "allow-db-area",
    "allow-db-sql",
    "allow-db-pick-zip",
    "allow-ws-get",
    "allow-ws-put",
    "allow-ws-delete-prefix",
    "allow-ws-stats",
    "allow-pack-pick",
    "allow-pack-write",
    "allow-ruas-pack-status",
    "allow-ruas-pack-tile",
    "allow-ruas-pack-import",
    "allow-ruas-pack-export",
    "allow-ruas-pack-download",
    "allow-ruas-pack-cancel"
  ],
  "remote": { "urls": ["http://localhost:*/", "http://127.0.0.1:*/"] }
}

{
  "name": "neogrid-neoenergia-pe",
  "productName": "NeoGrid",
  "version": "3.0.2",
  "description": "Console desktop para gestão de redes, postes e ativos elétricos, com módulo Projeto e Pacote de entrega.",
  "author": "NeoGrid",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File rust/scripts/run-app.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File rust/scripts/run-app.ps1",
    "package": "powershell -ExecutionPolicy Bypass -File rust/scripts/build-app.ps1 -Bundle nsis",
    "app:build": "powershell -ExecutionPolicy Bypass -File rust/scripts/build-app.ps1",
    "app:install": "powershell -ExecutionPolicy Bypass -File rust/scripts/build-app.ps1 -Install",
    "app:exe": "powershell -ExecutionPolicy Bypass -File rust/scripts/build-app.ps1 -Bundle none",
    "app:release-run": "powershell -ExecutionPolicy Bypass -File rust/scripts/run-app.ps1 -Profile release",
    "release": "powershell -ExecutionPolicy Bypass -File rust/scripts/release.ps1",
    "core:test": "cd rust && cargo test --target x86_64-pc-windows-gnu --workspace",
    "core:build": "cd rust && cargo build --release --target x86_64-pc-windows-gnu --workspace",
    "core:parity": "node rust/parity/contract-check.js",
    "e2e:projeto": "node rust/parity/e2e-projeto.js",
    "test:coord": "node rust/parity/coord-teste.mjs",
    "e2e:busca": "node rust/parity/e2e-busca.js",
    "e2e:print": "node rust/parity/e2e-print.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0"
  }
}
